# ─── Base de dados (PostgreSQL — ex.: Supabase ou Neon, plano grátis) ───
DATABASE_URL="postgres://utilizador:password@host:5432/base"
# Ligação direta (sem pooler) usada nas migrações. Se não tiver, repita o DATABASE_URL.
DIRECT_URL="postgres://utilizador:password@host:5432/base"

# ─── Endereço público do site (sem barra no fim) ───
NEXT_PUBLIC_SITE_URL="https://polish-and-glow.netlify.app"

# ─── Sessão do painel: uma frase longa e aleatória (32+ caracteres) ───
AUTH_SECRET="troque-isto-por-uma-frase-muito-longa-e-aleatoria"

# ─── Emails (Resend — plano grátis). Sem chave, os emails só aparecem nos registos. ───
RESEND_API_KEY=""
EMAIL_FROM="Luxe Nails <ola@exemplo.pt>"

# ─── Notificações no telemóvel (gere com: npm run vapid) ───
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:mumarley12@gmail.com"

# ─── Fotos: na Netlify ficam automaticamente no Netlify Blobs (não precisa de configurar nada). ───

# ─── Lembretes automáticos (função agendada da Netlify). Uma frase secreta qualquer. ───
CRON_SECRET="outra-frase-secreta"

# ─── SMS (em pausa). Só preencher quando quiser ligar os SMS. ───
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SENDER_ID="LuxeNails"

# ─── Primeiro acesso ao painel (criado automaticamente na primeira publicação) ───
ADMIN_EMAIL="mumarley12@gmail.com"
ADMIN_NAME="Sara Lopes"
ADMIN_PASSWORD="uma-password-forte-com-10-ou-mais-caracteres"
